{
  "name": "boreas-ui",
  "version": "1.0.0",
  "description": "Boreas WordPress UI - Reusable components with Tailwind CSS",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:html": "node scripts/build.js",
    "watch": "node scripts/watch-all.js",
    "clean": "rm -rf dist && mkdir -p dist",
    "preview": "open dist/index.html",
    "dev": "npm run build && npm run watch"
