  "license": "MIT",
  "devDependencies": {
    "chokidar": "^3.6.0",
    "cssnano": "^7.1.9",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
