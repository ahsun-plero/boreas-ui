<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Press and thematic research from Boreas on AI infrastructure, energy and our ETF lineup.">
  <title>Press | Boreas</title>
  <link rel="canonical" href="https://boreas.example.com/press.html">
  <link rel="icon" type="image/svg+xml" href="images/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="preload" as="image" href="images/hero-bg.jpg" fetchpriority="high">
  <meta property="og:title" content="Press | Boreas">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-white">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-50 focus:p-4 focus:bg-signature focus:text-white">Skip to main content</a>

  <%- include('../components/top-header') %>

  <%- include('../components/modal', {
    isOpen: false,
    modalId: 'boreas-modal'
  }) %>

  <%- include('../components/header') %>

  <main id="main-content">
    <%- include('../components/page-hero', {
      breadcrumbs: [
        {label: 'Home', href: '/'},
        {label: 'Press', href: '#'}
      ],
      title: 'Press',
      description: 'True-to-theme ETFs built with conviction — explore our full lineup of thematic exposures, each engineered around a genuine long-term trend.'
    }) %>

    <section class="bg-white py-12 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-15 xl:px-15">
        <h2 class="text-h5 font-bold text-charcoal mb-6">Filters</h2>

        <div class="mb-12">
          <label for="filter-category" class="block text-btn text-ink mb-2">Category</label>
          <div class="relative w-full md:w-1/3">
            <select id="filter-category" class="w-full h-12 pl-4 pr-12 border border-outline rounded-xs bg-white text-body font-normal text-charcoal appearance-none cursor-pointer focus:outline-none focus:border-charcoal focus:ring-1 focus:ring-mint transition-colors duration-200">
              <option value="" disabled selected>Select Category</option>
              <option value="thematic-research">Thematic Research</option>
            </select>
            <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-charcoal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"></path>
            </svg>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <%- include('../components/global-insights-card', {
            image: 'images/press-placeholder.svg',
            tagText: 'Thematic Research',
            title: 'The $1 Trillion Data Center Build-Out',
            date: 'August 06, 2026',
            description: 'Why private capital is rushing to fund specialized AI data campuses - and what it means for the infrastructure investors have overlooked until now.',
            ctaText: 'Read More →',
            ctaHref: '#'
          }) %>
          <%- include('../components/global-insights-card', {
            image: 'images/press-placeholder.svg',
            tagText: 'Thematic Research',
            title: 'The New Energy Paradigm for Compute',
            date: 'August 06, 2026',
            description: 'Exploring the symbiotic relationship between advanced computing infrastructure and next-generation energy investment - and why the two are becoming inseparable.',
            ctaText: 'Read More →',
            ctaHref: '#'
          }) %>
          <%- include('../components/global-insights-card', {
            image: 'images/press-placeholder.svg',
            tagText: 'Thematic Research',
            title: 'Boreas S&P AI Data, Power & Infrastructure Now on ADX',
            date: 'August 06, 2026',
            description: 'POWR\'s AED-denominated share class has officially begun trading on the Abu Dhabi Securities Exchange, expanding investor access across the UAE and GCC region.',
            ctaText: 'Read More →',
            ctaHref: '#'
          }) %>
        </div>

        <div class="flex justify-center mt-12">
          <button type="button" class="inline-flex items-center h-12 px-6 bg-white border-2 border-signature text-signature text-btn font-semibold hover:bg-signature hover:text-white transition-all duration-200 rounded-xs">
            Load More
          </button>
        </div>
      </div>
    </section>
  </main>

  <%- include('../components/newsletter', {
    title: 'Invest With The Wind At Your Back',
    subtitle: 'Thematic research, market developments and fund updates on the long-term forces shaping portfolios.',
    inputPlaceholder: 'Enter Email Address',
    buttonText: 'Sign Up',
    disclaimer: 'By signing up, you agree to receive market insights and product updates from Boreas'
  }) %>

  <%- include('../components/footer') %>
</body>
</html>
