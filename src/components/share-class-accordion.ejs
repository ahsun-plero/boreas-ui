<%
  // Props with defaults
  const title = locals.title || 'Share Class';
  const isin = locals.isin || '';
  const currency = locals.currency || '';
  const isDefault = locals.isDefault || false;
  const open = locals.open || false;
  const rows = locals.rows || [];
%>

<details class="group bg-white rounded-lg border border-gray-200 overflow-hidden" <%= open ? 'open' : '' %>>
  <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden bg-tint-signature px-6 md:px-8 py-8 flex flex-col gap-6 focus:outline-none focus-visible:ring-2 focus-visible:ring-mint">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 flex-wrap">
        <span class="text-subtitle font-bold text-charcoal"><%= title %></span>
        <% if (isDefault) { %>
          <span class="inline-flex items-center h-7 px-2.5 rounded-xs border border-boreas-600 bg-boreas-50 text-tag text-boreas-600">Default</span>
        <% } %>
      </div>
      <svg class="shrink-0 w-6 h-6 text-charcoal transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"></path>
      </svg>
    </div>
    <div class="flex flex-wrap gap-x-8 gap-y-2 text-body text-charcoal/80">
      <span><%= isin %></span>
      <span><%= currency %></span>
    </div>
  </summary>

  <div class="px-6 md:px-8 pt-6 md:pt-14 pb-6 md:pb-8">
    <!-- Desktop / Tablet: table -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-300">
            <th scope="col" class="w-[19%] pb-5 pr-6 text-left text-table-header text-charcoal font-medium">Exchange</th>
            <th scope="col" class="w-[23%] pb-5 pr-6 text-left text-table-header text-charcoal font-medium">Ticker</th>
            <th scope="col" class="w-[23%] pb-5 pr-6 text-left text-table-header text-charcoal font-medium">Exchange Currency</th>
            <th scope="col" class="pb-5 pr-6 text-left text-table-header text-charcoal font-medium">SEDOL</th>
            <th scope="col" class="pb-5 text-right text-table-header text-charcoal font-medium">Listing Date</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((row) => { %>
            <tr class="border-b border-gray-200 last:border-b-0">
              <td class="py-6 pr-6 text-body font-bold text-charcoal"><%= row.exchange %></td>
              <td class="py-6 pr-6 text-body text-charcoal/80"><%= row.ticker %></td>
              <td class="py-6 pr-6 text-body text-charcoal/80"><%= row.currency %></td>
              <td class="py-6 pr-6 text-body text-charcoal/80"><%= row.sedol %></td>
              <td class="py-6 text-right text-body text-charcoal/80"><%= row.listingDate %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Mobile: cards -->
    <ul class="md:hidden flex flex-col divide-y divide-gray-200">
      <% rows.forEach((row) => { %>
        <li class="py-6 first:pt-0 last:pb-0 grid grid-cols-2 gap-x-4 gap-y-4">
          <div>
            <p class="text-body font-bold text-charcoal">Exchange</p>
            <p class="text-body text-charcoal/80"><%= row.exchange %></p>
          </div>
          <div class="text-right">
            <p class="text-body font-bold text-charcoal">Ticker</p>
            <p class="text-body text-charcoal/80"><%= row.ticker %></p>
          </div>
          <div>
            <p class="text-body font-bold text-charcoal">Trading Currency</p>
            <p class="text-body text-charcoal/80"><%= row.currency %></p>
          </div>
          <div class="text-right">
            <p class="text-body font-bold text-charcoal">SEDOL</p>
            <p class="text-body text-charcoal/80"><%= row.sedol %></p>
          </div>
          <div>
            <p class="text-body font-bold text-charcoal">Listing Date</p>
            <p class="text-body text-charcoal/80"><%= row.listingDate %></p>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
</details>
