<%
  // Props with defaults
  const title = locals.title || 'Card Title';
  const variant = locals.variant || 'default';
  const content = locals.content || [];
  const description = locals.description || '';

  // Determine styling based on variant
  const isDefaultVariant = variant === 'default';
  const isTintVariant = variant === 'tint';

  const bgClass = isTintVariant ? 'bg-tint-signature' : 'bg-white';
  const titleColorClass = isTintVariant ? 'text-signature' : 'text-charcoal';
  const contentColorClass = isTintVariant ? 'text-charcoal' : 'text-charcoal';
%>

<div class="<%= bgClass %> rounded-[12px] border border-card-border p-6">
  <!-- Card Title -->
  <h3 class="text-h5 font-bold <%= titleColorClass %> mb-4">
    <%= title %>
  </h3>

  <!-- Content Section -->
  <% if (isDefaultVariant) { %>
    <!-- Description (optional) -->
    <% if (description) { %>
      <p class="text-body <%= contentColorClass %> mb-6">
        <%= description %>
      </p>
    <% } %>
    <!-- Bullet List for Default Variant -->
    <ul class="space-y-3">
      <% content.forEach(function(item) { %>
        <li class="flex items-start gap-3">
          <span class="text-mint flex-shrink-0 mt-1">•</span>
          <span class="text-body <%= contentColorClass %>">
            <%= item.text %>
          </span>
        </li>
      <% }); %>
    </ul>
  <% } else if (isTintVariant) { %>
    <!-- Paragraphs for Tint Variant -->
    <div class="space-y-4">
      <% content.forEach(function(item) { %>
        <p class="text-body <%= contentColorClass %>">
          <%= item.text %>
        </p>
      <% }); %>
    </div>
  <% } %>
</div>
