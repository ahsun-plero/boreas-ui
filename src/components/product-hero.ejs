<%
  // Props with defaults
  const breadcrumbs = locals.breadcrumbs || [];
  const ticker = locals.ticker || '';
  const title = locals.title || '';
  const subtitle = locals.subtitle || '';
  const stats = locals.stats || [];
  const downloadButtons = locals.downloadButtons || [];
  const priceCard = locals.priceCard || {};
  const ctaText = locals.ctaText || 'Explore';
  const ctaHref = locals.ctaHref || '#';

  // Determine if change is positive or negative
  const isPositiveChange = priceCard.change && parseFloat(priceCard.change) >= 0;
%>

<section class="relative text-white py-12 md:py-20 lg:py-24 bg-hero">
  <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-15">

    <!-- Breadcrumb Navigation -->
    <% if (breadcrumbs.length > 0) { %>
      <nav class="mb-8" aria-label="Breadcrumb">
        <div class="flex items-center gap-2 text-body-sm text-white/60">
          <% breadcrumbs.forEach((crumb, index) => { %>
            <% if (index > 0) { %>
              <span class="text-white/40">/</span>
            <% } %>
            <a href="<%= crumb.href %>" class="hover:text-white transition-colors">
              <%= crumb.label %>
            </a>
          <% }) %>
        </div>
      </nav>
    <% } %>

    <!-- Main Content Grid: Text Content + Price Card -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mb-12">

      <!-- Left Column: Title, Subtitle, Ticker -->
      <div class="flex flex-col justify-center">
        <!-- Ticker Badge -->
        <% if (ticker) { %>
          <div class="mb-4 w-fit">
            <span class="inline-block px-4 py-2 bg-white/10 border border-white/20 rounded-full text-body-sm text-white font-semibold">
              <%= ticker %>
            </span>
          </div>
        <% } %>

        <!-- Title -->
        <h1 class="text-h1 text-white font-bold mb-4 leading-tight">
          <%= title %>
        </h1>

        <!-- Subtitle -->
        <p class="text-body text-white/80 mb-8">
          <%= subtitle %>
        </p>
      </div>

      <!-- Right Column: Price Card -->
      <div class="flex flex-col justify-center">
        <div class="bg-white rounded-lg p-6 md:p-8">
          <!-- NAV Value -->
          <div class="mb-6">
            <p class="text-body-sm text-charcoal/60 mb-2 font-medium">NAV</p>
            <p class="text-h4 font-bold text-charcoal mb-3">
              <%= priceCard.nav || '$0.00' %>
            </p>

            <!-- Change Indicator -->
            <% if (priceCard.change !== undefined) { %>
              <div class="flex items-center gap-2">
                <span class="<%= isPositiveChange ? 'text-green-600' : 'text-red-600' %> font-semibold text-body">
                  <%= isPositiveChange ? '+' : '' %><%= priceCard.change || '0.00' %>
                </span>
                <span class="<%= isPositiveChange ? 'text-green-600' : 'text-red-600' %> font-semibold text-body">
                  <%= isPositiveChange ? '+' : '' %><%= priceCard.changePercent || '0%' %>
                </span>
              </div>
            <% } %>
          </div>

          <!-- Divider -->
          <div class="border-t border-gray-200 my-6"></div>

          <!-- Additional Info Grid -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <!-- AUM -->
            <% if (priceCard.aum) { %>
              <div>
                <p class="text-body-sm text-charcoal/60 mb-1 font-medium">AUM</p>
                <p class="text-body font-semibold text-charcoal">
                  <%= priceCard.aum %>
                </p>
              </div>
            <% } %>

            <!-- YTD Return -->
            <% if (priceCard.ytdReturn) { %>
              <div>
                <p class="text-body-sm text-charcoal/60 mb-1 font-medium">YTD Return</p>
                <p class="text-body font-semibold text-charcoal">
                  <%= priceCard.ytdReturn %>
                </p>
              </div>
            <% } %>
          </div>

          <!-- As Of Date -->
          <% if (priceCard.asOfDate) { %>
            <p class="text-body-sm text-charcoal/60 mb-6">
              As of <%= priceCard.asOfDate %>
            </p>
          <% } %>

          <!-- CTA Button -->
          <a
            href="<%= ctaHref %>"
            class="inline-flex items-center justify-center w-full h-12 bg-gold text-signature text-btn font-semibold rounded-lg hover:bg-gold/90 transition-all duration-200"
          >
            <%= ctaText %>
          </a>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <% if (stats.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 mb-12">
        <% stats.forEach((stat) => { %>
          <div class="bg-white rounded-lg p-4 md:p-6 border-l-4 border-mint">
            <p class="text-h6 text-charcoal font-bold mb-2">
              <%= stat.label %>
            </p>
            <p class="text-body text-charcoal/80">
              <%= stat.value %>
            </p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- Download Buttons Section -->
    <% if (downloadButtons.length > 0) { %>
      <div class="pt-8 border-t border-white/20">
        <p class="text-body-sm text-white/80 mb-4 font-medium">Download Documents</p>
        <div class="flex flex-wrap gap-3">
          <% downloadButtons.forEach((button) => { %>
            <a
              href="<%= button.href %>"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 border border-white/30 text-white rounded-full text-body hover:bg-white/10 transition-all duration-200"
            >
              <% if (button.icon) { %>
                <!-- Icon placeholder - replace with actual icon if needed -->
                <span class="text-sm">📥</span>
              <% } %>
              <span><%= button.label %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</section>
