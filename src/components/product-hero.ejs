<%
  // Props with defaults
  const breadcrumbs = locals.breadcrumbs || [];
  const ticker = locals.ticker || '';
  const title = locals.title || '';
  const subtitle = locals.subtitle || '';
  const stats = locals.stats || [];
  const downloadButtons = locals.downloadButtons || [];
  const priceCard = locals.priceCard || {};
  const ctaText = locals.ctaText || 'Explore';
  const ctaHref = locals.ctaHref || '#';

  // Determine if change is positive or negative
  const isPositiveChange = priceCard.change && parseFloat(priceCard.change) >= 0;
%>

<section class="relative text-white bg-hero flex items-center pt-[172px] lg:pt-[188px] pb-20">
  <div class="max-w-7xl mx-auto px-4 md:px-8 w-full lg:px-15 xl:px-15">

    <!-- Main Content Grid: Left Column (ALL Content) + Right Column (Price Card) -->
    <div class="grid grid-cols-1 min-[769px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_440px] gap-12 items-start">

      <!-- LEFT COLUMN: All Content (2 columns) -->
      <div class="flex flex-col justify-start">

        <!-- Breadcrumb Navigation -->
        <% if (breadcrumbs.length > 0) { %>
          <nav class="mb-6" aria-label="Breadcrumb">
            <div class="flex items-center gap-2 text-body text-white leading-6">
              <% breadcrumbs.forEach((crumb, index) => { %>
                <% if (index > 0) { %>
                  <svg class="w-4 h-4 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 6l6 6-6 6"></path></svg>
                <% } %>
                <a
                  href="<%= crumb.href %>"
                  class="<%= index === breadcrumbs.length - 1 ? 'font-bold' : 'font-normal' %> hover:text-mint transition-colors">
                  <%= crumb.label %>
                </a>
              <% }) %>
            </div>
          </nav>
        <% } %>

        <!-- Ticker as Large Title -->
        <% if (ticker) { %>
          <h1 class="text-h3 md:text-h2 lg:text-h1 font-bold text-white mb-4 leading-tight">
            <%= ticker %>
          </h1>
        <% } %>

        <!-- Subtitle (S&P data style) -->
        <% if (subtitle) { %>
          <h2 class="text-subtitle text-white font-medium mb-2 leading-none">
            <%= subtitle %>
          </h2>
        <% } %>

        <!-- Description (Unlocking institutions style) -->
        <% if (title) { %>
          <p class="text-body text-white mb-12 leading-6 max-w-xl font-normal">
            <%= title %>
          </p>
        <% } %>

        <!-- Stats Section -->
        <% if (stats.length > 0) { %>
          <div class="flex justify-between gap-6 md:grid md:grid-cols-3 md:justify-normal">
            <% stats.forEach((stat) => { %>
              <div>
                <p class="text-table-header text-white mb-3">
                  <%= stat.label %>
                </p>
                <p class="text-h4 min-[1025px]:text-h3 font-bold text-white leading-none">
                  <%= stat.value %>
                </p>
              </div>
            <% }) %>
          </div>
        <% } %>

      </div>

      <!-- RIGHT COLUMN: Price Card Only (1 column) -->
      <div class="flex flex-col justify-start items-start">
        <div class="bg-white rounded-2xl p-6 w-full shadow-xl">
          <!-- NAV label and as-of date -->
          <div class="flex justify-between items-start gap-4">
            <p class="text-caption-sm font-medium text-charcoal/80 leading-[1.2] tracking-[0.6px]">NAV</p>
            <% if (priceCard.asOfDate) { %>
              <p class="text-caption-sm font-normal text-charcoal/80 leading-[1.2] tracking-[0.6px] text-right">
                *Data as of <%= priceCard.asOfDate %>.
              </p>
            <% } %>
          </div>

          <!-- NAV value and daily change -->
          <div class="flex justify-between items-end mt-1">
            <p class="text-h4 text-charcoal leading-[normal]">
              <%= priceCard.nav || '$0.00' %>
            </p>
            <% if (priceCard.changePercent !== undefined) { %>
              <p class="text-h6 <%= isPositiveChange ? 'text-[#397D11]' : 'text-red-600' %>">
                <%= isPositiveChange ? '↑' : '↓' %> <%= priceCard.changePercent || '0%' %> (1D)
              </p>
            <% } %>
          </div>

          <!-- Divider -->
          <div class="border-t border-gray-200 mt-4 mb-4"></div>

          <!-- AUM and YTD Return labels -->
          <div class="flex justify-between items-start">
            <p class="text-caption-sm font-medium text-charcoal/80 leading-[1.2] tracking-[0.6px]">AUM</p>
            <p class="text-caption-sm font-medium text-charcoal/80 leading-[1.2] tracking-[0.6px] text-right">YTD Return</p>
          </div>

          <!-- AUM and YTD Return values -->
          <div class="flex justify-between items-start mt-1">
            <% if (priceCard.aum) { %>
              <p class="font-['Familjen_Grotesk'] text-base font-semibold text-charcoal leading-[22px]">
                <%= priceCard.aum %>
              </p>
            <% } %>
            <% if (priceCard.ytdReturn) { %>
              <p class="font-['Familjen_Grotesk'] text-base font-semibold text-[#397D11] leading-[22px] text-right">
                <%= priceCard.ytdReturn %>
              </p>
            <% } %>
          </div>

          <!-- CTA Button -->
          <button
            type="button"
            class="w-full h-12 mt-6 bg-gold text-signature text-btn font-semibold rounded-xs hover:bg-gold-hover transition-all duration-200"
          >
            <%= ctaText %>
          </button>
        </div>
      </div>
    </div>

    <!-- Download Buttons Section (Below Grid on Mobile, Aligned Left on Desktop) -->
    <% if (downloadButtons.length > 0) { %>
      <div class="pt-12 w-full">
        <div class="flex flex-wrap gap-3">
          <% downloadButtons.forEach((button) => { %>
            <a
              href="<%= button.href %>"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center h-8 px-4 border-2 border-white text-white rounded-[24px] text-btn capitalize hover:bg-white/10 transition-all duration-200"
              title="<%= button.label %>"
            >
              <span><%= button.label %></span>
              <% if (button.icon) { %>
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</section>
