<%
  // Props with defaults
  const breadcrumbs = locals.breadcrumbs || [];
  const ticker = locals.ticker || '';
  const title = locals.title || '';
  const subtitle = locals.subtitle || '';
  const stats = locals.stats || [];
  const downloadButtons = locals.downloadButtons || [];
  const priceCard = locals.priceCard || {};
  const ctaText = locals.ctaText || 'Explore';
  const ctaHref = locals.ctaHref || '#';

  // Determine if change is positive or negative
  const isPositiveChange = priceCard.change && parseFloat(priceCard.change) >= 0;
%>

<section class="relative text-white pt-16 pb-12 lg:pt-20 lg:pb-16 bg-hero">
  <div class="max-w-7xl mx-auto px-4 md:px-8 w-full">

    <!-- Breadcrumb Navigation -->
    <% if (breadcrumbs.length > 0) { %>
      <nav class="mb-3" aria-label="Breadcrumb">
        <div class="flex items-center gap-2 text-body-sm text-white/70">
          <% breadcrumbs.forEach((crumb, index) => { %>
            <% if (index > 0) { %>
              <span class="text-white/50">/</span>
            <% } %>
            <a href="<%= crumb.href %>" class="hover:text-white transition-colors">
              <%= crumb.label %>
            </a>
          <% }) %>
        </div>
      </nav>
    <% } %>

    <!-- Main Content Grid: Text Content (Left) + Price Card (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-16">

      <!-- Left Column: Title, Subtitle, Description -->
      <div class="flex flex-col justify-center pr-0 lg:pr-8">
        <!-- Ticker as Large Title -->
        <% if (ticker) { %>
          <h1 class="text-6xl lg:text-7xl font-bold text-white mb-4 leading-tight">
            <%= ticker %>
          </h1>
        <% } %>

        <!-- Subtitle (smaller heading) -->
        <% if (subtitle) { %>
          <h2 class="text-h4 text-white/90 font-semibold mb-4">
            <%= subtitle %>
          </h2>
        <% } %>

        <!-- Description -->
        <% if (title) { %>
          <p class="text-body text-white/80 mb-6 leading-relaxed max-w-md">
            <%= title %>
          </p>
        <% } %>
      </div>

      <!-- Right Column: Price Card -->
      <div class="flex flex-col justify-center items-start lg:items-end">
        <div class="bg-white rounded-2xl p-8 w-full lg:w-96 shadow-xl">
          <!-- NAV Header with Change -->
          <div class="flex items-start justify-between mb-6">
            <div>
              <p class="text-caption-sm text-charcoal/60 mb-1 font-medium">NAV</p>
              <p class="text-5xl font-bold text-charcoal leading-tight">
                <%= priceCard.nav || '$0.00' %>
              </p>
            </div>

            <!-- Change Indicator (Right aligned) -->
            <% if (priceCard.changePercent !== undefined) { %>
              <div class="text-right">
                <div class="flex items-baseline gap-1">
                  <span class="<%= isPositiveChange ? 'text-green-600' : 'text-red-600' %> text-lg font-semibold">
                    <%= isPositiveChange ? '↑' : '↓' %>
                  </span>
                  <div>
                    <p class="<%= isPositiveChange ? 'text-green-600' : 'text-red-600' %> font-bold text-lg leading-tight">
                      <%= isPositiveChange ? '' : '' %><%= priceCard.changePercent || '0%' %>
                    </p>
                    <p class="text-caption-sm text-charcoal/60">(1D)</p>
                  </div>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Divider -->
          <div class="border-t border-gray-200 my-6"></div>

          <!-- AUM and YTD Return Row -->
          <div class="grid grid-cols-2 gap-8 mb-6">
            <!-- AUM -->
            <% if (priceCard.aum) { %>
              <div>
                <p class="text-caption-sm text-charcoal/60 mb-2 font-medium">AUM</p>
                <p class="text-h5 font-bold text-charcoal">
                  <%= priceCard.aum %>
                </p>
              </div>
            <% } %>

            <!-- YTD Return -->
            <% if (priceCard.ytdReturn) { %>
              <div class="text-right">
                <p class="text-caption-sm text-charcoal/60 mb-2 font-medium">YTD Return</p>
                <p class="text-h5 font-bold text-green-600">
                  <%= priceCard.ytdReturn %>
                </p>
              </div>
            <% } %>
          </div>

          <!-- As Of Date -->
          <% if (priceCard.asOfDate) { %>
            <p class="text-caption-sm text-charcoal/60 mb-8">
              *Data as of <%= priceCard.asOfDate %>.
            </p>
          <% } %>

          <!-- CTA Button -->
          <button
            type="button"
            class="w-full h-12 bg-gold text-signature text-btn font-semibold rounded-lg hover:bg-gold/90 transition-all duration-200"
          >
            <%= ctaText %>
          </button>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <% if (stats.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 lg:gap-16 mb-12 mt-12 lg:mt-8">
        <% stats.forEach((stat) => { %>
          <div>
            <p class="text-caption-sm text-white/70 mb-3 font-medium uppercase tracking-wide">
              <%= stat.label %>
            </p>
            <p class="text-4xl lg:text-5xl font-bold text-white">
              <%= stat.value %>
            </p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- Download Buttons Section -->
    <% if (downloadButtons.length > 0) { %>
      <div class="pt-8 border-t border-white/20">
        <div class="flex flex-wrap gap-3">
          <% downloadButtons.forEach((button) => { %>
            <a
              href="<%= button.href %>"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 border-2 border-white text-white rounded-full text-body-sm font-medium hover:bg-white/10 transition-all duration-200"
              title="<%= button.label %>"
            >
              <% if (button.icon) { %>
                <!-- Download icon SVG -->
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
              <% } %>
              <span><%= button.label %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</section>
