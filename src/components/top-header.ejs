<!-- Top Header - Sticky Utility Bar -->
<div id="top-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 h-7 bg-white/20">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between h-full">
    <!-- Left: Powered by Lunate -->
    <div class="flex items-center gap-2">
      <img src="images/lunate-logo.svg" alt="Lunate Logo" class="h-3 w-auto">
    </div>

    <!-- Right: Dropdown Menus -->
    <!-- Desktop Layout (LG+) -->
    <div class="hidden lg:flex items-center gap-8">
      <!-- Global Dropdown -->
      <button type="button" class="flex items-center gap-2 text-body-sm leading-normal text-white text-center hover:text-mint transition-colors group" id="global-btn" data-open-modal="boreas-modal">
        <img src="images/global-icon.svg" alt="" aria-hidden="true" class="w-4 h-4 group-hover:opacity-80">
        <span>Global</span>
      </button>

      <!-- Institutional Dropdown -->
      <button type="button" class="flex items-center gap-2 text-body-sm leading-normal text-white text-center hover:text-mint transition-colors group" id="institutional-btn" data-open-modal="boreas-modal">
        <img src="images/institutional-icon.svg" alt="" aria-hidden="true" class="w-4 h-4 group-hover:opacity-80">
        <span>Institutional</span>
        <img src="images/dropdown-arrow.svg" alt="" aria-hidden="true" class="w-4 h-4 group-hover:opacity-80">
      </button>
    </div>

    <!-- Mobile Layout (SM/MD) -->
    <button type="button" class="lg:hidden flex items-center gap-2 text-body-sm leading-normal text-white text-center hover:text-mint transition-colors group" id="mobile-selector-btn" data-open-modal="boreas-modal">
      <span>Global / Institutional</span>
      <img src="images/dropdown-arrow.svg" alt="" aria-hidden="true" class="w-4 h-4 group-hover:opacity-80">
    </button>
  </div>
</div>

<script defer src="js/top-header.js"></script>
