<%
  const title = locals.title || 'True-to-Theme ETFs. High Conviction Tailwind Themes.';
  const subtitle = locals.subtitle || 'Boreas provides European institutional and retail investors access to high conviction themes of the next decade.';
  const ctaText = locals.ctaText || 'Explore ETFs';
  const ctaHref = locals.ctaHref || '#etfs';
%>

<section class="relative text-white py-20 md:py-32 lg:py-48 min-h-screen flex items-center bg-hero">
  <!-- Background overlay applied via gradient -->

  <div class="relative max-w-7xl mx-auto px-4 md:px-8 w-full">
    <div class="max-w-2xl">
      <!-- Title - H1 Style -->
      <h1 class="text-h3 md:text-h2 lg:text-h1 text-white font-bold leading-tight mb-6 md:mb-8">
        True-to-Theme ETFs.<br>
        High Conviction Tailwind Themes.
      </h1>

      <!-- Subtitle - Body Style -->
      <p class="text-body text-white mb-10 md:mb-12">
        <%= subtitle %>
      </p>

      <!-- CTA Button -->
      <a
        href="<%= ctaHref %>"
        class="inline-flex items-center h-12 px-8 bg-gold text-signature text-btn font-semibold rounded-lg hover:bg-gold/90 transition-all duration-200"
      >
        <%= ctaText %>
      </a>
    </div>
  </div>
</section>
