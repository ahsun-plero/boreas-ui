<%
  // Props with defaults
  const title = locals.title || 'Growth of a Hypothetical $10,000';
  const subtitle = locals.subtitle || '';
  const ranges = locals.ranges || [];
  const data = locals.data || { labels: [], datasets: [] };
  const legendItems = locals.legendItems || [];
  const chartId = locals.chartId || 'performanceChart';
%>

<div class="bg-white p-6 rounded-lg border border-gray-200">
  <!-- Header Section: Title/Subtitle on Left, Range Buttons on Right -->
  <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-8 gap-6">
    <!-- Title and Subtitle -->
    <div>
      <h3 class="text-h5 font-bold text-charcoal mb-2">
        <%= title %>
      </h3>
      <% if (subtitle) { %>
        <p class="text-body-sm text-charcoal/60">
          <%= subtitle %>
        </p>
      <% } %>
    </div>

    <!-- Range Selector Pills -->
    <div class="flex flex-wrap gap-0 bg-tint-signature rounded-[4px] p-1">
      <% ranges.forEach((range, index) => { %>
        <button
          class="range-pill text-caption-sm font-medium px-4 py-2 rounded-[4px] transition-all duration-200 <%= index === 0 ? 'bg-white text-charcoal' : 'bg-tint-signature text-charcoal hover:bg-tint-signature/80' %>"
          data-range="<%= range.value %>"
          data-chart-id="<%= chartId %>"
          aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
        >
          <%= range.label %>
        </button>
      <% }); %>
    </div>
  </div>

  <!-- Legend (Top Right, inline with header on larger screens) -->
  <% if (legendItems && legendItems.length > 0) { %>
    <div class="flex flex-wrap gap-6 mb-8 md:absolute md:top-6 md:right-6">
      <% legendItems.forEach(item => { %>
        <div class="flex items-center gap-2">
          <div
            class="w-3 h-3 rounded-full"
            style="background-color: <%= item.color %>"
            aria-hidden="true"
          ></div>
          <span class="text-body-sm text-charcoal">
            <%= item.label %>
          </span>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Chart Container -->
  <div class="relative mt-8">
    <div class="h-48 sm:h-60 md:h-80 w-full" style="aspect-ratio: 16/9;">
      <canvas id="<%= chartId %>" class="w-full"></canvas>
    </div>
  </div>
</div>

<!-- Chart.js Library from CDN (with defer for performance) -->
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<!-- Component Data Setup -->
<script>
  // Embed chart data and configuration for this instance
  (function() {
    const chartId = '<%= chartId %>';
    const chartsData = window.chartsData || {};

    // Store chart configuration for this instance
    chartsData['<%= chartId %>'] = {
      title: '<%= title %>',
      ranges: <%- JSON.stringify(ranges) %>,
      data: <%- JSON.stringify(data) %>,
      legendItems: <%- JSON.stringify(legendItems) %>
    };

    window.chartsData = chartsData;
  })();
</script>

<!-- Performance Chart Component JavaScript -->
<script defer src="js/performance-chart.js"></script>
