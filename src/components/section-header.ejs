<%
  const title = locals.title || 'Section Title';
  const action = locals.action || null;
%>

<div class="flex flex-row items-center justify-between gap-4">
  <!-- Title -->
  <h2 class="font-display text-h4 text-charcoal font-bold">
    <%= title %>
  </h2>

  <!-- Action Button (Optional) -->
  <% if (action) { %>
    <a
      href="<%= action.href || '#' %>"
      class="inline-flex items-center gap-2 text-signature text-btn font-bold capitalize border-b-2 border-signature hover:text-signature/80 transition-colors duration-200 w-fit"
    >
      <span><%= action.label %></span>
      <% if (action.icon === 'download') { %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      <% } %>
    </a>
  <% } %>
</div>
