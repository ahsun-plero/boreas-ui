<%
  const title = locals.title || 'Section Title';
  const action = locals.action || null;
%>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <!-- Title -->
  <h2 class="text-h4 lg:text-h3 text-charcoal font-bold">
    <%= title %>
  </h2>

  <!-- Action Button (Optional) -->
  <% if (action) { %>
    <a
      href="<%= action.href || '#' %>"
      class="inline-flex items-center gap-2 h-12 px-6 bg-white border border-charcoal/20 text-charcoal text-body font-semibold rounded-lg hover:bg-charcoal/5 transition-all duration-200"
    >
      <% if (action.icon === 'download') { %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      <% } %>
      <span><%= action.label %></span>
    </a>
  <% } %>
</div>
