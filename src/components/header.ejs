<header id="header" class="fixed left-0 right-0 z-40 transition-all duration-300 bg-transparent top-7">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 flex items-center justify-between">
    <!-- Logo/Branding -->
    <div class="flex items-center">
      <img src="images/boreas-logo.svg" alt="Boreas Logo" class="h-8 w-auto" width="140" height="32">
    </div>

    <!-- Navigation Menu (Desktop) -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
      <a href="#" class="text-mint font-bold transition-colors font-body text-base leading-5">Home</a>

      <!-- Our ETFs Dropdown -->
      <div class="relative group" id="desktop-etf-dropdown">
        <button type="button" class="flex items-center gap-2 text-white hover:text-white transition-colors font-body text-base font-normal leading-5" id="desktop-etf-btn" aria-haspopup="true" aria-expanded="false">
          Our ETFs
          <img src="images/dropdown-arrow.svg" alt="" aria-hidden="true" class="w-4 h-4" width="16" height="16">
        </button>

        <!-- Dropdown Menu -->
        <div class="absolute hidden group-hover:block group-focus-within:block top-full left-0 mt-2 bg-signature rounded-lg shadow-lg py-2 min-w-max z-50" role="menu" aria-labelledby="desktop-etf-btn">
          <a href="/etf/luxy" role="menuitem" class="block px-4 py-2 text-white hover:bg-signature/80 transition-colors font-body text-base font-normal leading-5">LUXY</a>
          <a href="/etf/ocean" role="menuitem" class="block px-4 py-2 text-white hover:bg-signature/80 transition-colors font-body text-base font-normal leading-5">OCEAN</a>
          <a href="/etf/tech" role="menuitem" class="block px-4 py-2 text-white hover:bg-signature/80 transition-colors font-body text-base font-normal leading-5">TECH</a>
        </div>
      </div>

      <a href="#boreas-way" class="text-white hover:text-white transition-colors font-body text-base font-normal leading-5">Insights</a>
      <a href="/about" class="text-white hover:text-white transition-colors font-body text-base font-normal leading-5">About Us</a>
      <a href="/contact" class="text-white hover:text-white transition-colors font-body text-base font-normal leading-5">Contact Us</a>
    </nav>

    <!-- Desktop CTA Button -->
    <button type="button" class="hidden lg:flex items-center h-12 px-6 bg-gold hover:bg-gold/90 text-signature text-btn font-semibold rounded-lg transition-colors">
      Subscribe
    </button>

    <!-- Mobile Hamburger Menu -->
    <button type="button" id="hamburger-btn" class="lg:hidden text-white hover:text-gold transition-colors" aria-label="Toggle menu" aria-expanded="false">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden fixed top-mobile-menu left-0 right-0 bg-white shadow-lg z-30 max-h-screen overflow-y-auto">
    <nav class="flex flex-col" aria-label="Mobile Navigation">
      <a href="/" class="px-4 md:px-8 py-4 text-charcoal text-body font-medium border-b border-gray-200 hover:bg-bg-light transition-colors">Home</a>

      <!-- Our ETFs Dropdown in Mobile -->
      <div class="border-b border-gray-200">
        <button type="button" class="w-full px-4 md:px-8 py-4 text-charcoal text-body font-medium hover:bg-bg-light transition-colors flex items-center justify-between" id="mobile-etf-btn" aria-haspopup="true" aria-expanded="false">
          Our ETFs
          <svg class="mobile-etf-arrow w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </button>
        <!-- Dropdown Items -->
        <div id="mobile-etf-menu" class="hidden bg-bg-light">
          <a href="/etf/luxy" class="block px-8 py-3 text-charcoal text-body font-medium hover:bg-gray-200 transition-colors">LUXY</a>
          <a href="/etf/ocean" class="block px-8 py-3 text-charcoal text-body font-medium hover:bg-gray-200 transition-colors">OCEAN</a>
          <a href="/etf/tech" class="block px-8 py-3 text-charcoal text-body font-medium hover:bg-gray-200 transition-colors">TECH</a>
        </div>
      </div>

      <a href="#boreas-way" class="px-4 md:px-8 py-4 text-charcoal text-body font-medium border-b border-gray-200 hover:bg-bg-light transition-colors">Insights</a>
      <a href="/about" class="px-4 md:px-8 py-4 text-charcoal text-body font-medium border-b border-gray-200 hover:bg-bg-light transition-colors">About Us</a>
      <a href="/contact" class="px-4 md:px-8 py-4 text-charcoal text-body font-medium border-b border-gray-200 hover:bg-bg-light transition-colors">Contact Us</a>
    </nav>

    <!-- Mobile Subscribe Button -->
    <div class="p-4 md:px-8 border-t border-gray-200">
      <button type="button" class="w-full flex items-center justify-center h-12 bg-gold hover:bg-gold/90 text-signature px-6 rounded-lg font-semibold text-btn transition-colors">
        Subscribe
      </button>
    </div>
  </div>
</header>

<script defer src="js/header-navigation.js"></script>
