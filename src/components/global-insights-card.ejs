<%
  // Props with defaults
  const image = locals.image || 'https://via.placeholder.com/600x400';
  const tagText = locals.tagText || 'Market Updates';
  const title = locals.title || 'Global Market Insights';
  const date = locals.date || 'October 02, 2026';
  const description = locals.description || 'Explore the latest trends and developments in global markets and investment opportunities.';
  const ctaText = locals.ctaText || 'Read More →';
  const ctaHref = locals.ctaHref || '#';
%>

<div class="flex flex-col bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden min-h-[500px]">
  <!-- Image Section with Tag -->
  <div class="relative overflow-hidden group">
    <!-- Featured Image -->
    <img
      src="<%= image %>"
      alt="<%= title %>"
      width="800"
      height="400"
      loading="lazy"
      decoding="async"
      class="w-full h-48 sm:h-60 md:h-72 object-cover group-hover:brightness-95 transition-all duration-300">

    <!-- Tag Badge -->
    <div class="absolute top-3 sm:top-4 md:top-5 left-3 sm:left-4 md:left-5">
      <span class="inline-block px-3 py-2 bg-white text-charcoal text-tag font-normal rounded-lg">
        <%= tagText %>
      </span>
    </div>
  </div>

  <!-- Card Content Section -->
  <div class="flex flex-col flex-1 p-3 sm:p-4 md:p-5">
    <!-- Date -->
    <time class="text-caption-sm text-charcoal/80 mb-2 sm:mb-3 md:mb-4">
      <%= date %>
    </time>

    <!-- Title -->
    <h3 class="text-h5 font-bold text-charcoal mb-2 sm:mb-3 md:mb-4">
      <%= title %>
    </h3>

    <!-- Description -->
    <p class="text-body text-charcoal/80 mb-4 sm:mb-5 md:mb-6 flex-grow">
      <%= description %>
    </p>

    <!-- CTA Link -->
    <a
      href="<%= ctaHref %>"
      class="inline-block text-signature text-btn font-semibold capitalize transition-colors duration-200 hover:text-signature/80 border-b-2 border-signature w-fit"
      aria-label="<%= ctaText %>"
    >
      <%= ctaText %>
    </a>
  </div>
</div>
